#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float PI = 3.14159265358979323846;
const float RAY_EPSILON = 0.002;
const float FAR_DISTANCE = 1.0e30;
const int MAX_CAR_ELLIPSOIDS = 16;

struct Vertex {
    vec4 position;
    vec4 normal;
    vec4 tangent;
    vec4 uv;
    vec4 color;
};

struct Triangle {
    uvec4 data;
};

struct BvhNode {
    vec4 boundsMin;
    vec4 boundsMax;
    uvec4 metadata;
};

struct Material {
    vec4 surface;
    vec4 optical;
    vec4 transmission;
};

layout(std140, binding = 0) uniform CameraData {
    vec4 cameraOrigin;
    vec4 cameraForward;
    vec4 cameraRight;
    vec4 cameraUp;
    vec4 sunDirection;
    vec4 viewportFrame;
    vec4 renderInfo;
    vec4 carColor;
    vec4 ellipsoidCenter[MAX_CAR_ELLIPSOIDS];
    vec4 ellipsoidRadii[MAX_CAR_ELLIPSOIDS];
    vec4 ellipsoidInverseRotation[MAX_CAR_ELLIPSOIDS];
} camera;

layout(std430, binding = 1) readonly buffer BvhNodes {
    BvhNode bvhNodes[];
};
layout(std430, binding = 2) readonly buffer Triangles {
    Triangle triangles[];
};
layout(std430, binding = 3) readonly buffer Vertices {
    Vertex vertices[];
};
layout(std430, binding = 4) readonly buffer Materials {
    Material materials[];
};
layout(binding = 5) uniform sampler2DArray materialTextures;
layout(binding = 6) uniform sampler2DArray materialNormalTextures;
layout(binding = 7) uniform sampler2DArray materialRoughnessTextures;
layout(binding = 8) uniform sampler2D environmentTexture;
layout(rgba16f, binding = 9) uniform image2D outputImage;

struct Hit {
    float distance;
    uint triangleIndex;
    vec2 barycentric;
    int ellipsoidIndex;
};

vec3 quaternionRotate(vec4 quaternion, vec3 value) {
    return value +
           2.0 * cross(quaternion.xyz,
                       cross(quaternion.xyz, value) +
                       quaternion.w * value);
}

float boundsDistance(vec3 origin,
                     vec3 inverseDirection,
                     BvhNode node,
                     float maximumDistance) {
    vec3 first = (node.boundsMin.xyz - origin) * inverseDirection;
    vec3 second = (node.boundsMax.xyz - origin) * inverseDirection;
    vec3 nearPlane = min(first, second);
    vec3 farPlane = max(first, second);
    float nearDistance =
            max(max(nearPlane.x, nearPlane.y), nearPlane.z);
    float farDistance =
            min(min(farPlane.x, farPlane.y), farPlane.z);
    return farDistance >= max(nearDistance, 0.0) &&
                   nearDistance < maximumDistance
            ? max(nearDistance, 0.0)
            : FAR_DISTANCE;
}

bool intersectTriangle(vec3 origin,
                       vec3 direction,
                       uint triangleIndex,
                       inout Hit hit) {
    Triangle triangle = triangles[triangleIndex];
    vec3 a = vertices[triangle.data.x].position.xyz;
    vec3 b = vertices[triangle.data.y].position.xyz;
    vec3 c = vertices[triangle.data.z].position.xyz;
    vec3 edgeAB = b - a;
    vec3 edgeAC = c - a;
    vec3 p = cross(direction, edgeAC);
    float determinant = dot(edgeAB, p);
    if (abs(determinant) < 1.0e-8) return false;
    float inverseDeterminant = 1.0 / determinant;
    vec3 t = origin - a;
    float u = dot(t, p) * inverseDeterminant;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(t, edgeAB);
    float v = dot(direction, q) * inverseDeterminant;
    if (v < 0.0 || u + v > 1.0) return false;
    float distance = dot(edgeAC, q) * inverseDeterminant;
    if (distance <= RAY_EPSILON || distance >= hit.distance) return false;
    hit.distance = distance;
    hit.triangleIndex = triangleIndex;
    hit.barycentric = vec2(u, v);
    hit.ellipsoidIndex = -1;
    return true;
}

bool intersectEllipsoid(vec3 origin,
                        vec3 direction,
                        int ellipsoidIndex,
                        float maximumDistance,
                        out float hitDistance) {
    hitDistance = maximumDistance;
    vec3 center = camera.ellipsoidCenter[ellipsoidIndex].xyz;
    vec3 radii = max(camera.ellipsoidRadii[ellipsoidIndex].xyz,
                     vec3(0.001));
    vec4 inverseRotation =
            camera.ellipsoidInverseRotation[ellipsoidIndex];
    vec3 localOrigin =
            quaternionRotate(inverseRotation, origin - center) / radii;
    vec3 localDirection =
            quaternionRotate(inverseRotation, direction) / radii;
    float a = dot(localDirection, localDirection);
    float b = dot(localOrigin, localDirection);
    float c = dot(localOrigin, localOrigin) - 1.0;
    float discriminant = b * b - a * c;
    if (discriminant < 0.0) return false;
    float root = sqrt(discriminant);
    float distance = (-b - root) / a;
    if (distance <= RAY_EPSILON) distance = (-b + root) / a;
    if (distance <= RAY_EPSILON || distance >= maximumDistance) return false;
    hitDistance = distance;
    return true;
}

Hit traceScene(vec3 origin, vec3 direction, float maximumDistance) {
    Hit hit;
    hit.distance = maximumDistance;
    hit.triangleIndex = 0u;
    hit.barycentric = vec2(0.0);
    hit.ellipsoidIndex = -1;

    vec3 safeDirection = vec3(
            abs(direction.x) < 1.0e-8 ? 1.0e-8 : direction.x,
            abs(direction.y) < 1.0e-8 ? 1.0e-8 : direction.y,
            abs(direction.z) < 1.0e-8 ? 1.0e-8 : direction.z);
    vec3 inverseDirection = 1.0 / safeDirection;
    uint stack[64];
    int stackSize = 1;
    stack[0] = 0u;
    while (stackSize > 0) {
        uint nodeIndex = stack[--stackSize];
        BvhNode node = bvhNodes[nodeIndex];
        if (boundsDistance(origin, inverseDirection, node,
                           hit.distance) >= FAR_DISTANCE) {
            continue;
        }
        uint triangleCount = node.metadata.w;
        if (triangleCount > 0u) {
            for (uint index = 0u; index < triangleCount; ++index) {
                intersectTriangle(origin, direction,
                                  node.metadata.z + index, hit);
            }
        } else if (stackSize <= 61) {
            uint leftIndex = node.metadata.x;
            uint rightIndex = node.metadata.y;
            float leftDistance = boundsDistance(
                    origin, inverseDirection, bvhNodes[leftIndex],
                    hit.distance);
            float rightDistance = boundsDistance(
                    origin, inverseDirection, bvhNodes[rightIndex],
                    hit.distance);
            if (leftDistance < rightDistance) {
                if (rightDistance < FAR_DISTANCE)
                    stack[stackSize++] = rightIndex;
                if (leftDistance < FAR_DISTANCE)
                    stack[stackSize++] = leftIndex;
            } else {
                if (leftDistance < FAR_DISTANCE)
                    stack[stackSize++] = leftIndex;
                if (rightDistance < FAR_DISTANCE)
                    stack[stackSize++] = rightIndex;
            }
        }
    }

    int ellipsoidCount = int(camera.renderInfo.z + 0.5);
    for (int index = 0; index < ellipsoidCount; ++index) {
        float ellipsoidDistance;
        if (intersectEllipsoid(origin, direction, index, hit.distance,
                               ellipsoidDistance)) {
            hit.distance = ellipsoidDistance;
            hit.triangleIndex = 0u;
            hit.barycentric = vec2(0.0);
            hit.ellipsoidIndex = index;
        }
    }
    return hit;
}

bool sceneOccluded(vec3 origin,
                   vec3 direction,
                   float maximumDistance) {
    vec3 safeDirection = vec3(
            abs(direction.x) < 1.0e-8 ? 1.0e-8 : direction.x,
            abs(direction.y) < 1.0e-8 ? 1.0e-8 : direction.y,
            abs(direction.z) < 1.0e-8 ? 1.0e-8 : direction.z);
    vec3 inverseDirection = 1.0 / safeDirection;
    uint stack[64];
    int stackSize = 1;
    stack[0] = 0u;
    while (stackSize > 0) {
        uint nodeIndex = stack[--stackSize];
        BvhNode node = bvhNodes[nodeIndex];
        if (boundsDistance(origin, inverseDirection, node,
                           maximumDistance) >= FAR_DISTANCE) {
            continue;
        }
        uint triangleCount = node.metadata.w;
        if (triangleCount > 0u) {
            Hit candidate;
            candidate.distance = maximumDistance;
            candidate.ellipsoidIndex = -1;
            for (uint index = 0u; index < triangleCount; ++index) {
                if (intersectTriangle(
                            origin, direction,
                            node.metadata.z + index, candidate)) {
                    return true;
                }
            }
        } else if (stackSize <= 61) {
            stack[stackSize++] = node.metadata.x;
            stack[stackSize++] = node.metadata.y;
        }
    }

    int ellipsoidCount = int(camera.renderInfo.z + 0.5);
    for (int index = 0; index < ellipsoidCount; ++index) {
        float ellipsoidDistance;
        if (intersectEllipsoid(
                    origin, direction, index, maximumDistance,
                    ellipsoidDistance)) {
            return true;
        }
    }
    return false;
}

vec3 environmentColor(vec3 direction, float lodValue) {
    float longitude = atan(direction.z, direction.x);
    float latitude = acos(clamp(direction.y, -1.0, 1.0));
    vec2 uv = vec2(longitude / (2.0 * PI) + 0.5,
                   latitude / PI);
    return textureLod(environmentTexture, uv, clamp(lodValue, 0.0, 10.0)).rgb;
}

void triangleSurface(Hit hit,
                     vec3 incomingDirection,
                     out vec3 normal,
                     out vec3 tangent,
                     out vec3 baseColor,
                     out vec4 surface,
                     out vec4 optical,
                     out vec4 transmission,
                     out uint materialIndex) {
    Triangle triangle = triangles[hit.triangleIndex];
    Vertex a = vertices[triangle.data.x];
    Vertex b = vertices[triangle.data.y];
    Vertex c = vertices[triangle.data.z];
    float w = 1.0 - hit.barycentric.x - hit.barycentric.y;
    normal = normalize(a.normal.xyz * w +
                       b.normal.xyz * hit.barycentric.x +
                       c.normal.xyz * hit.barycentric.y);
    if (dot(normal, incomingDirection) > 0.0) normal = -normal;
    tangent = normalize(a.tangent.xyz * w +
                        b.tangent.xyz * hit.barycentric.x +
                        c.tangent.xyz * hit.barycentric.y);
    tangent = normalize(tangent - normal * dot(normal, tangent));
    vec2 uv = a.uv.xy * w + b.uv.xy * hit.barycentric.x +
              c.uv.xy * hit.barycentric.y;
    vec4 vertexColor = a.color * w +
                       b.color * hit.barycentric.x +
                       c.color * hit.barycentric.y;
    materialIndex = min(triangle.data.w, 16u);
    float textureLodValue = clamp(
            log2(max(hit.distance, 1.0)) * 0.55 - 1.0,
            0.0, 8.0);
    vec3 textureColor = textureLod(
            materialTextures,
            vec3(fract(uv), float(materialIndex)),
            textureLodValue).rgb;
    Material material = materials[materialIndex];
    surface = material.surface;
    optical = material.optical;
    transmission = material.transmission;
    bool usesVertexColor = surface.w > 0.5;
    baseColor = textureColor *
                (usesVertexColor ? vertexColor.rgb : vec3(1.0));

    if (transmission.w > 0.5) {
        surface.x = clamp(surface.x * textureLod(
                materialRoughnessTextures,
                vec3(fract(uv), float(materialIndex)),
                textureLodValue).r, 0.04, 1.0);
    }
    if (transmission.z > 0.5 && optical.x > 0.0) {
        vec3 tangentNormal = textureLod(
                materialNormalTextures,
                vec3(fract(uv), float(materialIndex)),
                textureLodValue).xyz * 2.0 - 1.0;
        tangentNormal.xy *= optical.x;
        tangentNormal = normalize(tangentNormal);
        vec3 bitangent = normalize(cross(normal, tangent));
        normal = normalize(tangent * tangentNormal.x +
                           bitangent * tangentNormal.y +
                           normal * tangentNormal.z);
        if (dot(normal, incomingDirection) > 0.0) normal = -normal;
    }
}

void surfaceData(Hit hit,
                 vec3 hitPosition,
                 vec3 incomingDirection,
                 out vec3 normal,
                 out vec3 tangent,
                 out vec3 baseColor,
                 out vec4 surface,
                 out vec4 optical,
                 out vec4 transmission) {
    if (hit.ellipsoidIndex >= 0) {
        vec3 center =
                camera.ellipsoidCenter[hit.ellipsoidIndex].xyz;
        vec3 radii = max(
                camera.ellipsoidRadii[hit.ellipsoidIndex].xyz,
                vec3(0.001));
        vec4 inverseRotation =
                camera.ellipsoidInverseRotation[hit.ellipsoidIndex];
        vec4 worldRotation =
                vec4(-inverseRotation.xyz, inverseRotation.w);
        vec3 localPosition =
                quaternionRotate(inverseRotation,
                                 hitPosition - center);
        vec3 localNormal =
                normalize(localPosition / (radii * radii));
        normal = normalize(
                quaternionRotate(worldRotation, localNormal));
        if (dot(normal, incomingDirection) > 0.0)
            normal = -normal;
        tangent = normalize(cross(
                abs(normal.y) < 0.9 ? vec3(0.0, 1.0, 0.0)
                                    : vec3(1.0, 0.0, 0.0),
                normal));
        baseColor = camera.carColor.rgb;
        surface = vec4(camera.carColor.a, 0.48, 0.0, 0.0);
        optical = vec4(0.0, 1.0, 0.42, 0.16);
        transmission = vec4(0.0, 1.5, 0.0, 0.0);
    } else {
        uint materialIndex;
        triangleSurface(hit, incomingDirection, normal, tangent, baseColor,
                        surface, optical, transmission, materialIndex);
    }
}

float distributionGgx(float normalHalf, float roughness) {
    float alpha = roughness * roughness;
    float alphaSquared = alpha * alpha;
    float denominator = normalHalf * normalHalf *
                        (alphaSquared - 1.0) + 1.0;
    return alphaSquared /
           max(PI * denominator * denominator, 1.0e-5);
}

float geometrySchlickGgx(float normalDirection, float roughness) {
    float amount = roughness + 1.0;
    float k = amount * amount * 0.125;
    return normalDirection /
           max(normalDirection * (1.0 - k) + k, 1.0e-5);
}

float geometrySmith(float normalView,
                    float normalLight,
                    float roughness) {
    return geometrySchlickGgx(normalView, roughness) *
           geometrySchlickGgx(normalLight, roughness);
}

vec3 fresnelSchlick(float cosine, vec3 reflectance) {
    return reflectance +
           (vec3(1.0) - reflectance) *
                   pow(clamp(1.0 - cosine, 0.0, 1.0), 5.0);
}

vec3 fresnelSchlickRoughness(float cosine,
                            vec3 reflectance,
                            float roughness) {
    return reflectance +
           (max(vec3(1.0 - roughness), reflectance) - reflectance) *
                   pow(clamp(1.0 - cosine, 0.0, 1.0), 5.0);
}

vec3 secondarySurfaceColor(Hit hit,
                           vec3 origin,
                           vec3 direction,
                           float environmentLod) {
    if (hit.distance >= FAR_DISTANCE * 0.5)
        return environmentColor(direction, environmentLod);
    vec3 hitPosition = origin + direction * hit.distance;
    vec3 normal;
    vec3 tangent;
    vec3 baseColor;
    vec4 surface;
    vec4 optical;
    vec4 transmission;
    surfaceData(hit, hitPosition, direction, normal, tangent, baseColor,
                surface, optical, transmission);
    vec3 environment = environmentColor(normal, 7.0);
    return baseColor * (0.08 + environment * 0.38) +
           baseColor * max(surface.z, 0.0) * 2.2;
}

vec3 realTimeRayTrace(vec3 origin, vec3 direction) {
    Hit hit = traceScene(origin, direction, FAR_DISTANCE);
    if (hit.distance >= FAR_DISTANCE * 0.5)
        return environmentColor(direction, 0.0);

    vec3 hitPosition = origin + direction * hit.distance;
    vec3 normal;
    vec3 tangent;
    vec3 baseColor;
    vec4 surface;
    vec4 optical;
    vec4 transmission;
    surfaceData(hit, hitPosition, direction, normal, tangent, baseColor,
                surface, optical, transmission);

    float roughness = clamp(surface.x, 0.045, 1.0);
    float metalness = clamp(surface.y, 0.0, 1.0);
    float specularAmount = clamp(optical.y, 0.0, 1.0);
    float clearcoatAmount = clamp(optical.z, 0.0, 1.0);
    float clearcoatRoughness = clamp(optical.w, 0.045, 1.0);
    vec3 viewDirection = normalize(-direction);
    vec3 lightDirection = normalize(camera.sunDirection.xyz);
    vec3 halfDirection = normalize(viewDirection + lightDirection);
    float normalView = max(dot(normal, viewDirection), 0.001);
    float normalLight = max(dot(normal, lightDirection), 0.0);
    float normalHalf = max(dot(normal, halfDirection), 0.0);
    float viewHalf = max(dot(viewDirection, halfDirection), 0.0);
    vec3 reflectance = mix(
            vec3(0.04 * max(specularAmount, 0.05)),
            baseColor, metalness);
    vec3 fresnel = fresnelSchlick(viewHalf, reflectance);
    vec3 diffuseWeight = (vec3(1.0) - fresnel) * (1.0 - metalness);

    vec3 diffuseEnvironment = environmentColor(normal, 7.5);
    vec3 reflectionDirection = reflect(direction, normal);
    vec3 specularEnvironment = environmentColor(
            reflectionDirection, roughness * 8.5);
    vec3 environmentFresnel = fresnelSchlickRoughness(
            normalView, reflectance, roughness);
    vec3 radiance =
            diffuseWeight * baseColor * diffuseEnvironment * 0.42 +
            specularEnvironment * environmentFresnel *
                    mix(0.24, 0.78, 1.0 - roughness) +
            baseColor * max(surface.z, 0.0) * 2.2;

    if (normalLight > 0.0 &&
        !sceneOccluded(
                hitPosition + normal * RAY_EPSILON * 2.0,
                lightDirection, FAR_DISTANCE)) {
        float distribution = distributionGgx(normalHalf, roughness);
        float geometry = geometrySmith(normalView, normalLight, roughness);
        vec3 specular = distribution * geometry * fresnel /
                max(4.0 * normalView * normalLight, 1.0e-4);
        vec3 sunRadiance = vec3(3.5, 3.28, 2.92);
        radiance +=
                (diffuseWeight * baseColor / PI + specular) *
                sunRadiance * normalLight;

        if (clearcoatAmount > 0.0) {
            float coatDistribution = distributionGgx(
                    normalHalf, clearcoatRoughness);
            float coatGeometry = geometrySmith(
                    normalView, normalLight, clearcoatRoughness);
            vec3 coatFresnel = fresnelSchlick(viewHalf, vec3(0.04));
            radiance += coatFresnel * coatDistribution * coatGeometry /
                    max(4.0 * normalView * normalLight, 1.0e-4) *
                    sunRadiance * normalLight * clearcoatAmount;
        }
    }

    float reflectionStrength =
            clamp(max(metalness, (1.0 - roughness) * 0.38) +
                          clearcoatAmount * 0.22,
                  0.0, 0.9);
    if (reflectionStrength > 0.05) {
        vec3 reflectionOrigin =
                hitPosition + normal * RAY_EPSILON * 2.0;
        Hit reflectionHit = traceScene(
                reflectionOrigin, reflectionDirection, FAR_DISTANCE);
        vec3 reflectionColor = secondarySurfaceColor(
                reflectionHit, reflectionOrigin,
                reflectionDirection, roughness * 8.5);
        vec3 localReflectionWeight = clamp(
                environmentFresnel * reflectionStrength,
                vec3(0.0), vec3(0.92));
        radiance = mix(radiance, reflectionColor,
                       localReflectionWeight);
    }

    float transmissionFactor = clamp(transmission.x, 0.0, 1.0);
    if (transmissionFactor > 0.01) {
        float indexOfRefraction = max(transmission.y, 1.01);
        vec3 refractionDirection = refract(
                direction, normal, 1.0 / indexOfRefraction);
        if (dot(refractionDirection, refractionDirection) > 1.0e-6) {
            refractionDirection = normalize(refractionDirection);
            vec3 refractionOrigin =
                    hitPosition - normal * RAY_EPSILON * 3.0;
            Hit refractionHit = traceScene(
                    refractionOrigin, refractionDirection, FAR_DISTANCE);
            vec3 transmissionColor = secondarySurfaceColor(
                    refractionHit, refractionOrigin,
                    refractionDirection, roughness * 7.0);
            transmissionColor *= mix(vec3(1.0), baseColor, 0.18);
            float dielectricFresnel =
                    fresnelSchlick(normalView, vec3(0.04)).r;
            float transmittedAmount =
                    transmissionFactor * (1.0 - dielectricFresnel);
            radiance = mix(radiance, transmissionColor,
                           clamp(transmittedAmount, 0.0, 0.92));
        }
    }
    return radiance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSizeValue = imageSize(outputImage);
    if (pixel.x >= imageSizeValue.x || pixel.y >= imageSizeValue.y) return;

    vec2 pixelPosition = vec2(pixel) + vec2(0.5);
    vec2 screen = pixelPosition / camera.viewportFrame.xy * 2.0 - 1.0;
    float aspect = camera.renderInfo.w;
    vec3 direction = normalize(
            camera.cameraForward.xyz +
            camera.cameraRight.xyz * screen.x *
                    camera.renderInfo.x * aspect +
            camera.cameraUp.xyz * screen.y * camera.renderInfo.x);

    vec3 sampleColor = realTimeRayTrace(
            camera.cameraOrigin.xyz, direction);
    imageStore(outputImage, pixel, vec4(sampleColor, 1.0));
}
